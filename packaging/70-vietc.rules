# SPDX-License-Identifier: MIT
# Grant active physical desktop seat access to /dev/uinput and /dev/input/event*
# via systemd-logind uaccess ACLs (runs before 73-seat-late.rules; no input group needed).
# Preserve distro GROUP/MODE on event* so input-group tools (gamepads, keyd, kanata) stay intact.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", GROUP="root", MODE="0600"
SUBSYSTEM=="input", KERNEL=="event*", TAG+="uaccess"
